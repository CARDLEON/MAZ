---
interface Brand {
  id: string;
  name: string;
  logo: string;
}

interface Props {
  brands: Brand[];
  title?: string;
  description?: string;
}

const {
  brands,
  title = "Confían en nosotros",
  description = "Nos enorgullece ser el socio tecnológico de las marcas más innovadoras del mercado. Nuestras soluciones de enfriamiento industrial y sistemas especializados respaldan los proyectos más exigentes.",
} = Astro.props;
---

<section
  class="bg-white px-4 sm:px-6 lg:px-16 py-12 sm:py-16 text-[#1e1e1e] font-[var(--font-poppins)]"
>
  <div class="max-w-6xl mx-auto space-y-8">
    <!-- Header Section -->
    <div class="text-center space-y-3">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#24408d]">
        {title}
      </h2>
      <p class="text-base sm:text-lg text-gray-600 max-w-3xl mx-auto leading-relaxed">
        {description}
      </p>
    </div>

    <!-- Brands Grid -->
    <div
      class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6 sm:gap-8 items-center justify-items-center"
    >
      {
        brands.map((brand) => (
          <div
            class="w-full h-32 flex items-center justify-center bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors duration-300 p-4"
            title={brand.name}
          >
            <img
              src={brand.logo}
              alt={`Logo de ${brand.name}`}
              class="max-w-full max-h-24 object-contain"
            />
          </div>
        ))
      }
    </div>

    <!-- CTA Section -->
    <div class="text-center pt-4 sm:pt-8">
      <p class="text-gray-700 text-base mb-6">
        ¿Listo para optimizar tu sistema de enfriamiento industrial?
      </p>
      <a
        href="/contacto"
        class="inline-block bg-[#24408d] hover:bg-[#1b3270] text-white font-semibold px-8 py-3 rounded transition duration-300"
      >
        Solicita tu evaluación gratuita
      </a>
    </div>
  </div>
</section>
